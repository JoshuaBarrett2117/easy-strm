# ==================== Easy-STRM 部署配置 ====================
# 复制此文件为 .env 并修改配置

# ==================== 应用配置 ====================
# 应用端口（对外暴露的端口）
APP_PORT=80

# 服务器访问地址（重要！用于生成STRM文件中的直链URL）
# 请修改为你的实际访问地址，例如：http://your-server-ip:80 或 https://your-domain.com
SERVER_URL=http://localhost:80

# JWT密钥（请修改为随机字符串，用于用户登录认证）
JWT_SECRET=please_change_this_secret_key_to_random_string

# ==================== 115 API 配置（可选） ====================
# 如果你有115开放平台的应用ID和密钥，可以填写
# 没有115开放平台账号也可以使用，系统会使用默认配置
APP_ID=
APP_SECRET=
REDIRECT_URI=
BASE_URL=https://proapi.115.com

# ==================== PostgreSQL 配置 ====================
# 数据库用户名
PG_USER=easystrm

# 数据库密码（请修改）
PG_PASSWORD=easystrm123

# 数据库名称
PG_DATABASE=easy_strm

# 数据库对外暴露端口（方便外部管理工具连接，可选）
PG_PORT_EXPOSE=5432

# ==================== Redis 配置 ====================
# Redis密码（可选，留空表示无密码）
REDIS_PASSWORD=

# Redis对外暴露端口（方便外部管理工具连接，可选）
REDIS_PORT_EXPOSE=6379

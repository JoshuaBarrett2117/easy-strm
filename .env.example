# ==================== Easy-STRM Docker 配置 ====================
# 复制此文件为 .env 并修改配置

# ==================== 应用配置 ====================
# 应用端口（对外暴露的端口）
APP_PORT=80

# 服务器访问地址（用于生成STRM文件中的直链URL）
SERVER_URL=http://localhost:80

# JWT密钥（请修改为随机字符串）
JWT_SECRET=easy_strm_jwt_secret

# ==================== 115 API 配置（可选） ====================
# 如果你有115开放平台的应用ID和密钥，可以填写
APP_ID=
APP_SECRET=
REDIRECT_URI=
BASE_URL=https://proapi.115.com

# ==================== PostgreSQL 配置 ====================
# 数据库用户名
PG_USER=postgres

# 数据库密码（请修改）
PG_PASSWORD=postgres

# 数据库名称
PG_DATABASE=easy_strm

# 数据库对外暴露端口（方便外部管理工具连接）
PG_PORT_EXPOSE=5432

# ==================== Redis 配置 ====================
# Redis密码（可选，留空表示无密码）
REDIS_PASSWORD=

# Redis对外暴露端口（方便外部管理工具连接）
REDIS_PORT_EXPOSE=6379

# ==================== Docker Hub 配置 ====================
# Docker Hub 用户名（用于推送镜像）
DOCKER_USERNAME=your_dockerhub_username
